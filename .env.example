# 이 파일을 `.env`로 복사한 뒤 키 값을 채워 넣으세요.
#
#   cp .env.example .env
#
# KAKAO_REST_API_KEY: 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
# (JavaScript 키가 아니라 REST API 키입니다.)
#
# 이 키는 서버(Vercel Serverless Function, api/kakao-search.js)에서만 읽습니다.
# 브라우저로는 절대 내려가지 않습니다.
#
# - 로컬 개발: `vercel dev`로 실행하면 이 저장소 루트의 `.env`를 자동으로 읽습니다.
#   (일반 정적 서버로는 api/ 함수가 동작하지 않습니다.)
# - 배포: Vercel 프로젝트 → Settings → Environment Variables → KAKAO_REST_API_KEY
#
# `.env`는 .gitignore에 등록되어 있어 커밋되지 않습니다.
KAKAO_REST_API_KEY=

# GOOGLE_PLACES_API_KEY: Google Cloud Console에서 발급한 API 키.
# 반드시 "Places API (New)"가 활성화된 키여야 합니다(레거시 "Places API"와는 별개 상품이라
# 별도로 활성화해야 하고, 결제 계정 연결이 필요합니다).
#
# 이 키도 서버(Vercel Serverless Function, api/google-reviews.js)에서만 읽습니다.
# 브라우저로는 절대 내려가지 않습니다.
#
# - 로컬 개발: `vercel dev`로 실행하면 이 저장소 루트의 `.env`를 자동으로 읽습니다.
# - 배포: Vercel 프로젝트 → Settings → Environment Variables → GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY=

# GEMINI_API_KEY: Google AI Studio(또는 Google Cloud)에서 발급한 Gemini API 키.
# 리뷰 텍스트를 감정 분류/키워드/한줄 요약으로 분석하는 데 씁니다.
#
# 이 키도 서버(Vercel Serverless Function, api/gemini-analyze.js)에서만 읽습니다.
# 브라우저로는 절대 내려가지 않습니다.
#
# - 로컬 개발: `vercel dev` 또는 `scripts/dev-server.js`로 실행하면 이 저장소 루트의 `.env`를 자동으로 읽습니다.
# - 배포: Vercel 프로젝트 → Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=
